@model DoAnWebGamingGear.Models.Products

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<main>
    @using (Html.BeginForm("AddToCart", "ShoppingCartt", FormMethod.Post))
    {
        <div class="container-fluid">
            <div class="product">
                <div class="collection-list" style="margin-left: 50px;">
                    @Html.TextBoxFor(row => row.ProductID, new { @class = "form-control", value = Model.ProductID, type = "hidden" })
                    <img src="@Url.Content("~/" + @Model.ProductPic)" alt="@Model.ProductName" style="width: 500px; float: left;" />
                    <div style="float: right; width: 800px;">
                        <h1>@Model.ProductName</h1>
                        @if (Model.SalePrice > 0)
                        {
                            <p>
                                <span style="color: black; text-decoration: line-through; font-size: 16px;">@Model.Price.ToString("c").Split(',')[0]đ</span>
                                <span style="color: red; font-size: 20px;">@Model.SalePrice.ToString("c").Split(',')[0]đ</span>
                            </p>
                        }
                        else
                        {
                            <p style="color: red; font-size: 20px;">@Model.Price.ToString("c").Split(',')[0]đ</p>
                        }
                        <hr />
                        <p>@Model.ProductDescription</p>

                        <p>
                            <strong>Availability Status:</strong>
                            @if (Model.AvailabilityStatus == "InStock")
                            {
                                @:Còn hàng
                            }
                            else if (Model.AvailabilityStatus == "OutOfStock")
                            {
                                @:Hết hàng
                            }
                        </p>
                        <p><strong>Bảo hành:</strong> @Model.BaoHanh</p>
                        <div class="vstack gap-4">

                            @if (@Model.Quantity > 0)
                            {
                                if (User.Identity.IsAuthenticated)
                                {
                                    <button type="submit" 
                                            class="logout btn-logout" 
                                            style="width: 800px; text-align: center; display: flex; justify-content: center; align-items: center;">
                                        Chọn mua
                                    </button>
                                }
                                else
                                {
                                    <a class="logout btn-logout" 
                                       style="width: 800px; text-align: center; display: flex; justify-content: center; align-items: center;" 
                                       href="@Url.Action("SaveReturnUrlAndRedirectToLogin", "Account", new { returnUrl = Request.Url.PathAndQuery })">
                                        Chọn mua
                                    </a>
                                }

                            }
                            else
                            {
                                <button type="button" class="btn-outofstock" disabled>
                                    <h5><strong>Hết hàng</strong></h5>
                                </button>
                            }
                        </div>
                    </div>

                </div>

            </div>

        </div>
    }
</main>