@model DoAnWebGamingGear.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<div class="container-fluid">
    <h4 style="text-align: center;">Chi tiết đơn hàng</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Mã đơn hàng</dt>
        <dd>@Model.OrderId</dd>
        <dt>Ngày đặt</dt>
        <dd>@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>
        <dt>Tổng tiền</dt>
        <dd>@Model.TotalAmount.ToString("N0").Replace(",", ".") ₫</dd>
        <dt>Trạng thái</dt>
        <dd>@Model.Status</dd>
    </dl>
    <h4>Chi tiết sản phẩm</h4>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Products.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0").Replace(",", ".") ₫</td>
                    <td>@item.Price.ToString("N0").Replace(",", ".") ₫</td>
                </tr>
            }
        </tbody>
    </table>
    <a href="@Url.Action("OrderHistory", "Account")" class="btn btn-primary">Quay lại lịch sử mua hàng</a>
</div>
