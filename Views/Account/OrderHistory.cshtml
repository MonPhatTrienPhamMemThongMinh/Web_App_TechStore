@model IEnumerable<DoAnWebGamingGear.Models.Order>

@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<div class="container">
    <h4 style="text-align: center;">Lịch sử mua hàng</h4>
    <hr />
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mã đơn hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>@order.TotalAmount.ToString("N0").Replace(",", ".") ₫</td>
                    <td>@order.Status</td>
                    <td>
                        <a href="@Url.Action("OrderDetails", "Account", new { id = order.OrderId })" class="btn btn-info">Xem chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
