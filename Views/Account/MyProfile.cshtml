@model DoAnWebGamingGear.ViewModel.MyProfile

@{
    ViewBag.Title = "MyProfile";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<div class="container">
    <h4 style="text-align: center;">Thông tin người dùng</h4>
    <hr />
    <dl class="dl-horizontal" style="border-radius: 10px;">
        <dt>Họ và tên</dt>
        <dd>
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt>Tên tài khoản</dt>
        <dd>
            @Html.DisplayFor(model => model.Username)
        </dd>
        <dt>Email</dt>
        <dd>
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt>Số điện thoại</dt>
        <dd>
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt>Thành phố</dt>
        <dd>
            @Html.DisplayFor(model => model.City)
        </dd>
        <dt>Ngày sinh</dt>
        <dd>
            @Html.DisplayFor(model => model.DateOfBirth)
        </dd>
        <dt>Địa chỉ</dt>
        <dd>
            @Html.DisplayFor(model => model.Address)
        </dd>
    </dl>
</div>
<div style="text-align: center; display: flex; justify-content: center; align-items: center;">
    <ul class="navbar-nav justify-content-center flex-wrap">
        <li class="nav-item" style="margin: 40px 20px 40px 20px;">
            <a class="btn btn-primary" style="width: 200px;" href="@Url.Action("OrderHistory", "Account")">Lịch sử mua hàng</a>
        </li>
        <li class="nav-item" style="margin: 40px 20px 40px 20px;">
            <a class="logout btn-logout" style="width: 200px;" href="/account/logout">Đăng xuất</a>
        </li>
    </ul>
</div>