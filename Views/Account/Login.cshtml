@model DoAnWebGamingGear.ViewModel.LoginVM

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}
<section class="vh-50 gradient-custom">
    <div class="container-fluid py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card bg-dark text-white" style="border-radius: 1rem;">
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        <div class="card-body p-5 text-center">

                            <div class="mb-md-5 mt-md-4 pb-5">

                                <h2 class="fw-bold mb-2 text-uppercase">Đăng nhập</h2>
                                <p class="text-white-50 mb-5">Hãy nhập tài khoản và mật khẩu</p>


                                <div class="form-outline form-white mb-4">
                                    @*@Html.LabelFor(temp => temp.Username)*@
                                    @Html.TextBoxFor(temp => temp.Username, new { placeholder = "Tên tài khoản", @class = "form-control form-control-lg" })
                                    @*@Html.ValidationMessageFor(temp => temp.Username, "", new { @class = "text-danger" })*@
                                </div>
                                <div class="form-outline form-white mb-4">
                                    <div class="col-md-12">
                                        @*@Html.LabelFor(temp => temp.Password)*@
                                        @Html.PasswordFor(temp => temp.Password, new { placeholder = "Mật khẩu", @class = "form-control form-control-lg" })
                                        @*  @Html.ValidationMessageFor(temp => temp.Password, "", new { @class = "text-danger" })*@
                                    </div>
                                </div>




                                <div>
                                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                                </div>



                                <button class="btn btn-outline-light btn-lg px-5" type="submit">Đăng nhập</button>

                                <div class="d-flex justify-content-center text-center mt-4 pt-1">
                                    <a href="#!" class="text-white"><i class="fab fa-facebook-f fa-lg"></i></a>
                                    <a href="#!" class="text-white"><i class="fab fa-twitter fa-lg mx-4 px-2"></i></a>
                                    <a href="#!" class="text-white"><i class="fab fa-google fa-lg"></i></a>
                                </div>

                            </div>

                            <div>
                                <p class="mb-0">
                                    Bạn chưa có tài khoản? Đăng ký <a href="/account/register" class="text-white-50 fw-bold">Tại đây</a>
                                </p>
                            </div>

                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</section>