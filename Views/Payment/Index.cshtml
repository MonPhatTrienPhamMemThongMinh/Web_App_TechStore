@model DoAnWebGamingGear.Models.Order

@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<script>
    function OnBeginCO() {
        $('#btnCheckOut').attr('disabled', "disabled");
        $('#load_send').html('<h3>Đang gửi....</h3>');
    }
</script>

<h2>Thông Tin Thanh Toán</h2>

@using (Html.BeginForm("Checkout", "Payment", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="CustomerName">Tên khách hàng:</label>
        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", placeholder = "Nhập tên của bạn", required = "required" })
        @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="CustomerPhone">Số điện thoại:</label>
        @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", placeholder = "Nhập số điện thoại", required = "required", type = "tel" })
        @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="CustomerAddress">Địa chỉ nhà:</label>
        @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control", placeholder = "Nhập địa chỉ của bạn", required = "required" })
        @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="CustomerProvince">Tỉnh/Thành phố:</label>
        @Html.DropDownListFor(m => m.CustomerProvince, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), "Chọn Tỉnh/Thành phố", new { @class = "form-control", id = "province", required = "required" })
        @Html.ValidationMessageFor(m => m.CustomerProvince, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="CustomerDistrict">Quận/Huyện:</label>
        @Html.DropDownListFor(m => m.CustomerDistrict, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), "Chọn Quận/Huyện", new { @class = "form-control", id = "district", required = "required" })
        @Html.ValidationMessageFor(m => m.CustomerDistrict, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="CustomerWard">Phường:</label>
        @Html.DropDownListFor(m => m.CustomerWard, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), "Chọn Phường", new { @class = "form-control", id = "ward", required = "required" })
        @Html.ValidationMessageFor(m => m.CustomerWard, "", new { @class = "text-danger" })
    </div>   

    <div class="form-group">
        <label for="CustomerEmail">Email:</label>
        @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", placeholder = "Nhập email của bạn", required = "required", type = "email" })
        @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label for="PaymentMethod">Hình thức thanh toán:</label>
        @Html.DropDownListFor(m => m.PaymentMethod, new SelectList(new List<string> { "Chuyển khoản ngân hàng", "Thanh toán khi nhận hàng" }), "Chọn phương thức thanh toán", new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
    </div>

    <div class="form-group" id="load_form_payment" style="display:none">
        <h4><label>Chọn phương thức thanh toán:</label><br></h4>
        <label><input type="radio" name="TypePaymentVN" value="0" /> Cổng thanh toán VNPAYQR</label><br />
        <label><input type="radio" name="TypePaymentVN" value="2" /> ATM-Tài khoản ngân hàng nội địa</label><br />
        <label><input type="radio" name="TypePaymentVN" value="3" /> Thanh toán qua thẻ quốc tế</label><br />
    </div>

    <h3>Chi Tiết Giỏ Hàng</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in ViewBag.CartItems)
            {
                <tr>
                    <td>@item.Products.ProductName</td>
                    <td>@item.shopping_quantity</td>
                    <td>
                        @if (item.Products.SalePrice > 0)
                        {
                            <span>@item.Products.SalePrice.ToString("N0") ₫</span>
                        }
                        else
                        {
                            <span>@item.Products.Price.ToString("N0") ₫</span>
                        }
                    </td>
                    <td>
                        @if (item.Products.SalePrice > 0)
                        {
                            <span>@(item.Products.SalePrice * item.shopping_quantity) ₫</span>
                        }
                        else
                        {
                            <span>@(item.Products.Price * item.shopping_quantity) ₫</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3">Tổng cộng:</td>
                <td>@ViewBag.TotalAmount.ToString("N0") ₫</td>
            </tr>
        </tfoot>
    </table>
    <div class="form-group" id="load_send"></div>
    <button type="submit" class="btn btn-success" id="btnCheckOut">Đặt Hàng</button>
}

@section Scripts {
    <script type="text/javascript">
        document.getElementById("PaymentMethod").addEventListener("change", function () {
            var paymentMethod = this.value;
            var loadFormPayment = document.getElementById("load_form_payment");
            if (paymentMethod === "Chuyển khoản ngân hàng") {
                loadFormPayment.style.display = "block";
            } else {
                loadFormPayment.style.display = "none";
            }
        });
    </script>
    <script>
        // Hàm gọi API và điền dữ liệu vào dropdown
        async function loadProvinces() {
            try {
                // Gọi API để lấy dữ liệu các tỉnh thành
                const response = await fetch('https://dev-online-gateway.ghn.vn/shiip/public-api/master-data/province', {
                    method: 'GET',
                    headers: {
                        'Token': '5c296349-b9e1-11ef-9083-dadc35c0870d' // Thêm token API của bạn nếu cần
                    }
                });
                const data = await response.json();

                if (data && data.data) {
                    // Lấy đối tượng dropdown
                    const dropdown = document.getElementById('province');

                    // Lặp qua các tỉnh thành và tạo các option
                    data.data.forEach(province => {
                        const option = document.createElement('option');
                        option.value = province.ProvinceID;
                        option.textContent = province.ProvinceName;
                        dropdown.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Lỗi khi gọi API:', error);
            }
        }
        async function loadDistricts(provinceId) {
            try {
                // Gọi API để lấy dữ liệu các tỉnh thành
                const url = "https://dev-online-gateway.ghn.vn/shiip/public-api/master-data/district?Province_id="+provinceId+"";
                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Token': '5c296349-b9e1-11ef-9083-dadc35c0870d' // Thêm token API của bạn nếu cần
                    }
                });
                console.log(response);
                const data = await response.json(); 
                if (data && data.data) {
                    // Lấy đối tượng dropdown
                    const dropdown = document.getElementById('district');
                    dropdown.disabled = false;
                    // Lặp qua các quận huyện và tạo các option
                    data.data.forEach(district => {
                        const option = document.createElement('option');
                        option.value = district.DistrictID;
                        option.textContent = district.DistrictName;
                        dropdown.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Lỗi khi gọi API:', error);
            }
        }
        async function loadWard(districtID) {
            try {
                // Gọi API để lấy dữ liệu các tỉnh thành
                const url = "https://dev-online-gateway.ghn.vn/shiip/public-api/master-data/ward?district_id=" + districtID + "";
                const response = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Token': '5c296349-b9e1-11ef-9083-dadc35c0870d' // Thêm token API của bạn nếu cần
                    }
                });
                console.log(response);
                const data = await response.json();
                if (data && data.data) {
                    // Lấy đối tượng dropdown
                    const dropdown = document.getElementById('ward');
                    dropdown.disabled = false;
                    // Lặp qua các phường và tạo các option
                    data.data.forEach(ward => {
                        const option = document.createElement('option');
                        option.value = ward.WardCode;
                        option.textContent = ward.WardName;
                        dropdown.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Lỗi khi gọi API:', error);
            }
        }
        // Gọi hàm loadProvinces khi trang web tải xong
        window.onload = loadProvinces;
        // Lắng nghe sự kiện thay đổi tỉnh/thành phố
        document.getElementById('province').addEventListener('change', function () {
            const provinceId = this.value;            
            if (provinceId) {             
                const dropdownDistrict = document.getElementById('district');
                dropdownDistrict.innerHTML = '';
                dropdownDistrict.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
                const dropdownWard = document.getElementById('ward');
                dropdownWard.innerHTML = '';
                dropdownWard.innerHTML = '<option value="">Chọn Phường</option>';
                loadDistricts(provinceId); // Gọi API quận/huyện khi tỉnh được chọn
            } else {
                const districtDropdown = document.getElementById('district');
                districtDropdown.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
                districtDropdown.disabled = true; // Vô hiệu hóa dropdown quận/huyện nếu chưa chọn tỉnh
            }
        });
        document.getElementById('district').addEventListener('change', function () {
            const districtId = this.value;
            if (districtId) {
                const dropdown = document.getElementById('ward');
                dropdown.innerHTML = '';
                dropdown.innerHTML = '<option value="">Chọn Phường</option>';
                loadWard(districtId); // Gọi API phường khi quận/huyện được chọn
            } else {
                const wardDropdown = document.getElementById('ward');
                wardDropdown.innerHTML = '<option value="">Chọn Phường</option>';
                wardDropdown.disabled = true; // Vô hiệu hóa dropdown quận/huyện nếu chưa chọn tỉnh
            }
        });
    </script>
}

