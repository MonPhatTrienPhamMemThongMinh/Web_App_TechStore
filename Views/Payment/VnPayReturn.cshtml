@model DoAnWebGamingGear.Models.Order
@{
    ViewBag.Title = "VnPayReturn";
    Layout = "~/Views/Shared/_LayoutPage1.cshtml";
}

<style>
    .card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(45deg, #28a745, #218838);
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #004085;
        }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card text-center">
                <div class="card-header bg-success text-white">
                    <h2>Cảm ơn bạn đã đặt hàng!</h2>
                </div>
                <div class="card-body">
                    @if (ViewBag.InnerText != null)
                    {
                        <p class="lead">@ViewBag.InnerText</p>
                    }
                    <h3 class="font-weight-bold">Mã đơn hàng của bạn là: @Model.OrderId</h3>
                    <p class="mt-4">@ViewBag.ThanhToanThanhCong</p>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Quay lại trang chủ</a>
                </div>
                <div class="card-footer text-muted">
                    Cảm ơn bạn đã mua sắm tại cửa hàng của chúng tôi!
                </div>
            </div>
        </div>
    </div>
</div>