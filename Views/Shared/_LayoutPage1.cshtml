<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/fontawesome.min.css" integrity="sha512-siarrzI1u3pCqFG2LEzi87McrBmq6Tp7juVsdmGY1Dr8Saw+ZBAzDzrGwX3vgxX1NkioYNCFOVC0GpDPss10zQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src="~/NivoSlider/jquery.nivo.slider.js"></script>
    <script src="~/NivoSlider/jquery.nivo.slider.pack.js"></script>
    <link rel="stylesheet" href="~/NivoSlider/nivo-slider.css" />
    <link rel="stylesheet" href="~/Style/gg.css" />
    <link href="~/Style/font-awesome.css" rel="stylesheet" />
</head>
<body>
    <header class="menu" style="margin-bottom: 120px;">
        <div class="">
            <nav class="navbar navbar-expand justify-content-between align-items-center" style="background-color: rgb(8, 36, 72); height: 120px;">
                <a class="navbar-brand header_main-nav" href="/home" style="color: white; margin: 10px 40px 10px 40px;"><img src="~/Pic/logoGG.png" width="50" style="border-radius: 1em;" /><span>GamingGear</span></a>
                <div>
                    <ul class="navbar-nav">
                        <li class="nav-item wrapper" style="margin: 40px 25px 40px 10px;">
                            <a href="/home" class="nav-link content" style="color: white">Trang chủ</a>
                        </li>
                        <li class="nav-item wrapper" style="margin: 40px 25px 40px 20px;">
                            <a href="/categories" class="nav-link content" style="color: white">Mặt hàng</a>
                        </li>
                        <li class="nav-item wrapper" style="margin: 40px 25px 40px 20px;">
                            <a href="/products" class="nav-link content" style="color: white">Sản phẩm</a>
                        </li>
                        <li class="nav-item wrapper" style="margin: 40px 25px 40px 20px;">
                            <a class="nav-link content" style="color: white">Hotline: 0775945228 </a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item" style="margin: 40px 20px 40px 20px;">
                                <a class="nav-link" href="/account/myprofile">
                                    <i class="fa-regular fa-user fa-lg" style="color: #ffffff;"></i>
                                </a>
                            </li>
                            <li class="nav-item" style="margin: 40px 40px 40px 0px;">
                                <a href="/ShoppingCartt/ShowToCart" class="nav-link">
                                    <i class="fa-solid fa-cart-shopping fa-lg" style="color: #ffffff;"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item" style="margin: 40px 20px 40px 20px; text-decoration: none;">
                                <a class="nav-link" href="/account/login">
                                    <i class="fa-regular fa-user fa-lg" style="color: #ffffff;"></i>
                                </a>
                            </li>
                            <li class="nav-item" style="margin: 40px 40px 40px 0px;">
                                <a href="/account/login" class="nav-link">
                                    <i class="fa-solid fa-cart-shopping fa-lg" style="color: #ffffff;"></i>
                                </a>
                            </li>
                        }


                    </ul>
                </div>
                <div>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            @using (Html.BeginForm("Index", "Products", FormMethod.Post, new { @class = "d-flex flex-row align-items-center flex-wrap" }))
                            {
                                <div class="form-group">
                                    <input type="search" class="form-control w-auto input-search"
                                           id="search" name="search" value="@ViewBag.Search" placeholder="Tìm sản phảm theo tên" />
                                </div>
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary mx-2"> <i class="fa-solid fa-magnifying-glass fa-lg" style="color: #ffffff;"></i></button>
                                </div>
                            }
                        </li>
                    </ul>
                </div>
            </nav>
        </div>

    </header>
    <div>
        @RenderBody()
    </div>
    <div class="khoangtrang"></div>

    <div class="container-fluid">
        <footer class="py-5" style="height: 100px;">
            <div class="row">
                <div class="col-3 col-md-3 mb-3 me-4">
                    <h5 style="font-size: 18px; text-transform: uppercase; letter-spacing: 1.4px; line-height: 22px; font-weight: 500; margin-left: 30px; margin-bottom: 15px; position: relative">CÔNG TY TNHH GAMINGGEAR</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2">
                            <i class="fa-solid fa-building-circle-arrow-right"></i>
                            Nhà phân phối độc quyền các thương hiệu Filco - Fnatic - Lethal Gaming Gear - CHERRY Xtrfy - Glorious
                        </li>
                        <li class="nav-item mb-2">
                            <i class="fa-solid fa-location-dot"></i>
                            140 Lê Trọng Tấn, Tây Thạnh, Tân Phú, Thành phố Hồ Chí Minh
                        </li>
                        <li class="nav-item mb-2">
                            <i class="fa-solid fa-phone"></i>
                            0775945228
                        </li>
                    </ul>
                </div>

                <div class="col-3 col-md-3 mb-3">
                    <h5 style="font-size: 18px; text-transform: uppercase; letter-spacing: 1.4px; line-height: 22px; font-weight: 500; margin-left: 30px; margin-bottom: 15px; position: relative">FOLLOW US</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2"><a href="/home" class=" p-0">Trang chủ</a></li>
                        <li class="nav-item mb-2"><a href="/products" class="p-0">Sản phẩm</a></li>
                        <li class="nav-item mb-2"><a href="#" class=" p-0">Pricing</a></li>
                        <li class="nav-item mb-2"><a href="#" class=" p-0">FAQs</a></li>
                        <li class="nav-item mb-2"><a href="#" class="p-0">About</a></li>
                    </ul>
                </div>

                <div class="col-3 col-md-1 mb-3">
                    <h5>Cửa hàng</h5>
                    <ul class="nav flex-column">
                        <li class="nav-item mb-2"><a href="#" class=" p-0">Thành phố Hồ Chí Minh</a></li>
                        <li class="nav-item mb-2"><a href="#" class="p-0">Hà Nội</a></li>
                        <li class="nav-item mb-2"><a href="#" class="p-0">Đà Nẵng</a></li>
                        <li class="nav-item mb-2"><a href="#" class="p-0">Long An</a></li>
                    </ul>
                </div>

                <div class="col-md-3 offset-md-1 mb-3">
                    <form>
                        <h5>Đăng ký nhận tin</h5>
                        <p>
                            Mua bàn phím cơ, keycap bộ, keycap lẻ, keycap resin. Bảo hành chính hãng. Ưu đãi khi mua online. Dịch vụ mods phím cơ uy tín, chất lượng.

                        </p>
                        <div class="d-flex flex-column flex-sm-row w-100 gap-2">
                            <label for="newsletter1" class="visually-hidden">Email address</label>
                            <input id="newsletter1" type="text" class="form-control" placeholder="Email của bạn">
                            <button class="btn btn-primary" type="button">Đăng ký</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between py-4 my-4 border-top">
                <p>© 2023 GamingGear, Inc. All rights reserved.</p>
                <ul class="list-unstyled d-flex">
                    <li class="ms-3"><a class="link-body-emphasis" href="#"><svg class="bi" width="24" height="24"><use xlink:href="#twitter"></use></svg></a></li>
                    <li class="ms-3"><a class="link-body-emphasis" href="#"><svg class="bi" width="24" height="24"><use xlink:href="#instagram"></use></svg></a></li>
                    <li class="ms-3"><a class="link-body-emphasis" href="#"><svg class="bi" width="24" height="24"><use xlink:href="#facebook"></use></svg></a></li>
                </ul>
            </div>
        </footer>
    </div>



</body>
</html>
