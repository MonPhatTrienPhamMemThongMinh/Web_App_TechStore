    @*<button id="chatbotButton" onclick="toggleChatbot()">Chat</button>
        <div id="chatbotContainer" style="display: none;">
            <div id="chatbotHeader">
                <span>Chatbot</span>
                <button onclick="toggleChatbot()">X</button>
            </div>
            <div id="chatbotBody">
                <div id="chatMessages" style="height: 200px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;"></div>
                <input type="text" id="userInput" placeholder="Ask me anything..." />
                <button onclick="sendMessage()">Send</button>
            </div>
        </div>*@
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
    <df-messenger intent="WELCOME"
                  chat-title="ChatbotGG"
                  agent-id="9d55863f-d732-467a-a76e-26733086499d"
                  language-code="en"></df-messenger>

    @RenderSection("Scripts", required: false)

    <style>
        #chatbotButton {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            font-size: 16px;
            cursor: pointer;
            z-index: 1000;
        }

        #chatbotContainer {
            position: fixed;
            bottom: 80px;
            right: 20px;
            width: 300px;
            background-color: white;
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }

        #chatbotHeader {
            background-color: #007bff;
            color: white;
            padding: 10px;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #chatbotBody {
            padding: 10px;
        }

            #chatbotBody input {
                width: calc(100% - 70px);
                padding: 5px;
                margin-right: 5px;
            }

            #chatbotBody button {
                padding: 5px 10px;
            }
    </style>

    <script>
        function toggleChatbot() {
            var chatbotContainer = document.getElementById("chatbotContainer");
            if (chatbotContainer.style.display === "none") {
                chatbotContainer.style.display = "block";
            } else {
                chatbotContainer.style.display = "none";
            }
        }

        function sendMessage() {
            var userInput = document.getElementById("userInput").value;
            var chatMessages = document.getElementById("chatMessages");

            // Hiển thị tin nhắn của người dùng
            var userMessage = document.createElement("div");
            userMessage.textContent = "You: " + userInput;
            chatMessages.appendChild(userMessage);

            // Gửi yêu cầu đến chatbot
            $.post("/Chatbot/GetResponse", { userInput: userInput }, function (data) {
                var botMessage = document.createElement("div");
                botMessage.textContent = "Bot: " + data.response;
                chatMessages.appendChild(botMessage);

                // Cuộn xuống cuối khung chat
                chatMessages.scrollTop = chatMessages.scrollHeight;
            });

            // Xóa nội dung input
            document.getElementById("userInput").value = "";
        }
    </script>
</body>
