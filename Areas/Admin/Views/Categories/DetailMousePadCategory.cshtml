@model DoAnWebGamingGear.Models.Categories

@{
    ViewBag.Title = "Lót chuột";
}

<main>
    <section>
        <div class="">
            <div class="test-custom" style="color: white; position: relative; ">
                <img src="@Model.CategoryBackground" style="border-radius: 0em;" />
                <div style=" position: absolute; top: 50%; left: 20%; transform: translate(-50%, -30%); background-color: rgba(255, 255, 255, 0.8); border-radius: 15px; width: 500px; ">
                    <div class="vstack" style="padding: 20px; border-radius: 15px; background-color: #272727; color: white; width: 800px; margin-right: 500px;">
                        <h1 style="font-size: 3.25rem; line-height: 1;">
                            @Model.CategoryName
                        </h1>
                        <div>
                            <p>@Model.CategoryDescription</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="container-fluid">
            <div class="product-div">
                <div class="page-item">
                    <div class="vstack" style="gap: 3rem;">
                        <h1 class="h1 text-center" style="margin: 40px 0px 20px 00px;">Tất cả sản phẩm</h1>
                        <div class="collection-list" style="margin-left: 130px;">
                            @foreach (var item in Model.Products)
                            {
                                <a href="/products/detail/@item.ProductID">
                                    <div class="product-card" style="width: 400px;">
                                        <div class="product-card-content">
                                            <img src="@item.ProductPic" class="product-image" />
                                            <h4 style="color: black;">@item.ProductName</h4>
                                            <p style="color: red; font-size: 20px;">@item.Price.ToString("c").Split(',')[0]<span>đ</span></p>
                                            <button class="product-button" style="color: white">Buy now</button>

                                        </div>
                                    </div>
                                </a>
                            }
                        </div>

                    </div>
                </div>
                <div class="product-effect"></div>
            </div>
        </div>
    </section>
</main>

