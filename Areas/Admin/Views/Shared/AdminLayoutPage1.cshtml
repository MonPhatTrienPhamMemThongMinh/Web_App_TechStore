<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/fontawesome.min.css" integrity="sha512-siarrzI1u3pCqFG2LEzi87McrBmq6Tp7juVsdmGY1Dr8Saw+ZBAzDzrGwX3vgxX1NkioYNCFOVC0GpDPss10zQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script src="~/NivoSlider/jquery.nivo.slider.js"></script>
    <script src="~/NivoSlider/jquery.nivo.slider.pack.js"></script>
    <link rel="stylesheet" href="~/NivoSlider/nivo-slider.css" />
    <link rel="stylesheet" href="~/Style/gg.css" />
</head>
<body>
    <header class="menu">
        <div class="">
            <nav class="navbar navbar-expand" style="background-color: rgb(8, 36, 72);">
                <a class="navbar-brand header_main-nav" href="/admin/home" style="color: white; margin: 10px 40px 10px 40px;"><img src="~/Pic/logoGG.png" width="60" style="border-radius: 1em;" /><span>GamingGear</span></a>
                <div>
                    <ul class="navbar-nav justify-content-center flex-wrap">
                        <li class="nav-item wrapper" style="margin: 40px 100px 40px 20px;">
                            <a href="/admin/home" class="nav-link content" style="color: white">Trang chủ</a>
                        </li>
                        <li class="nav-item wrapper" style="margin: 40px 100px 40px 20px;">
                            <a href="/admin/products" class="nav-link content" style="color: white">Sản phẩm</a>
                        </li>
                        <li class="nav-item wrapper" style="margin: 40px 100px 40px 20px;">
                            <a href="/admin/users" class="nav-link content" style="color: white">Users</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {

                            <li class="nav-item" style="margin: 40px 100px 40px 20px;">
                                <a class="nav-link content" style="color: white;" href="/account/logout">Logout</a>

                            </li>
                        }

                    </ul>
                </div>
                <ul class="nav navbar-nav" style="float: right;">
                    <li class="nav-item">
                        @using (Html.BeginForm("Index", "Products", FormMethod.Post, new { @class = "d-flex flex-row align-items-center flex-wrap", area = "Admin" }))
                        {
                            <div class="form-group">
                                <input type="search" class="form-control w-auto input-search"
                                       id="search" name="search" value="@ViewBag.Search" placeholder="Bạn cầm tìm gì?" />
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary mx-2"> <i class="fa-solid fa-magnifying-glass fa-lg" style="color: #ffffff;"></i></button>
                            </div>
                        }
                    </li>
                </ul>
            </nav>
        </div>
        @*<div style="justify-content: flex-end; justify-self: end; align-items: center; flex-wrap: wrap; display: flex; ">
                <div style="align-items: center; display: flex; gap: 1.5rem;">
                    <a style="position: relative;">
                        <i class="fa-solid fa-magnifying-glass fa-2xs" style="color: #ffffff; vertical-align: middle; display: block;"></i>
                    </a>
                </div>
            </div>*@
        @if (User.Identity.IsAuthenticated)
        {
            <div style="color: red; font-weight: bold">
                Hello @User.Identity.Name
            </div>
        }
    </header>
    <div>
        @RenderBody()
    </div>
</body>
</html>