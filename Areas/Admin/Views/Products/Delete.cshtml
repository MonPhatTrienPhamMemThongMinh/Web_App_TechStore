@model DoAnWebGamingGear.Models.Products

@{
    ViewBag.Title = "Delete Product";
}

<h2>Delete Product</h2>

<form action="/admin/products/delete/@Model.ProductID" method="post" class="container-fluid">
    <input type="hidden" name="ProductID" value="@Model.ProductID" />
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <h5>Tên sản phẩm</h5>
                <p>@Model.ProductName</p>
            </div>
            <div class="form-group">
                <h5>Giá</h5>
                <p>@Model.Price</p>
            </div>
            <div class="form-group">
                <h5>Brand</h5>
                <p>@Model.BrandID</p>
            </div>
            <div class="form-group">
                <h5>Category</h5>
                <p>@Model.CategoryID</p>
            </div>
        </div>
       
    </div>
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="/admin/products" class="btn btn-dark">Cancel</a>
</form>

